{
  "cleanupPeriodDays": 30,
  "enabledPlugins": {
    "example@example-marketplace": true
  },
  "env": {
    "EXAMPLE": "x"
  },
  "extraKnownMarketplaces": {
    "example-marketplace": {
      "source": {
        "source": "github",
        "repo": "example/example-marketplace"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__LUNCHROOM__ listen",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hooks/session-end.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__LUNCHROOM__ guard pretool",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hooks/check-a.sh"
          },
          {
            "type": "command",
            "command": "/opt/tools/check-b.sh"
          },
          {
            "type": "command",
            "command": "/usr/local/bin/hooks/check-c.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/check-d.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/check-e.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/check-f.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hooks/check-g.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/check-f.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__LUNCHROOM__ guard posttool",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hooks/prompt-note.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/prompt-context.sh"
          },
          {
            "type": "command",
            "command": "__LUNCHROOM__ guard prompt",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__LUNCHROOM__ listen",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-check.py"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "model": "example-model",
  "permissions": {
    "allow": [],
    "deny": [
      "Read(./.env)"
    ],
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "/usr/local/bin/statusline.sh"
  },
  "theme": "dark"
}

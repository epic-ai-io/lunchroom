# Proof 15 (permmodes): a real Lunchroom DENY in each Claude Code permission mode. (From proof 6 (hooktext): what the user sees of a multi-line hook text in the real
# Claude Code terminal screen.
#
# Claude Code is installed from Anthropic's own apt repository, as in ../packages/Containerfile.apt
# (https://code.claude.com/docs/en/setup.md, "Install with Linux package managers", apt tab; key
# fingerprint 31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE checked by the build).
#
# Build context: made by ../prove.sh.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DISTRO=apt
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      curl gnupg ca-certificates sudo python3 python3-pyte procps util-linux \
 && rm -rf /var/lib/apt/lists/*

RUN install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSL https://downloads.claude.ai/keys/claude-code.asc -o /etc/apt/keyrings/claude-code.asc \
 && gpg --show-keys --with-colons /etc/apt/keyrings/claude-code.asc | grep -q '^fpr:::::::::31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE:' \
 && echo "deb [signed-by=/etc/apt/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main" \
      > /etc/apt/sources.list.d/claude-code.list \
 && apt-get update \
 && apt-get install -y claude-code \
 && rm -rf /var/lib/apt/lists/*

COPY lunchroom lib.sh ptyrun.py sessionpty.py plaintext.py hang.py mockapi.py screen.py inner.sh /opt/proof/
RUN chmod 0755 /opt/proof/lunchroom /opt/proof/inner.sh /opt/proof/ptyrun.py /opt/proof/sessionpty.py \
      /opt/proof/plaintext.py /opt/proof/hang.py /opt/proof/mockapi.py /opt/proof/screen.py

CMD ["/opt/proof/inner.sh"]

# Proof 1 (packages), apt: Claude Code from Anthropic's own apt repository on Ubuntu 24.04.
#
# The repository setup is Anthropic's, copied from "Install with Linux package managers" (apt tab)
# at https://code.claude.com/docs/en/setup.md (read 2026-11-03): the signing key from
# https://downloads.claude.ai/keys/claude-code.asc, whose fingerprint must be
# 31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE, and the `stable` channel
# https://downloads.claude.ai/claude-code/apt/stable.
#
# Build context: made by ../prove.sh (the static `lunchroom` program, the files of ../common and
# the files of this folder, side by side).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DISTRO=apt
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      curl gnupg ca-certificates sudo python3 procps util-linux \
 && rm -rf /var/lib/apt/lists/*

# Anthropic's instructions, in order. The build stops if the key is not the documented one.
RUN install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSL https://downloads.claude.ai/keys/claude-code.asc -o /etc/apt/keyrings/claude-code.asc \
 && gpg --show-keys --with-colons /etc/apt/keyrings/claude-code.asc | grep -q '^fpr:::::::::31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE:' \
 && echo "deb [signed-by=/etc/apt/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main" \
      > /etc/apt/sources.list.d/claude-code.list \
 && apt-get update \
 && apt-get install -y claude-code \
 && rm -rf /var/lib/apt/lists/*

COPY lunchroom lib.sh ptyrun.py sessionpty.py plaintext.py hang.py inner.sh /opt/proof/
RUN chmod 0755 /opt/proof/lunchroom /opt/proof/inner.sh /opt/proof/ptyrun.py /opt/proof/sessionpty.py \
      /opt/proof/plaintext.py /opt/proof/hang.py

CMD ["/opt/proof/inner.sh"]

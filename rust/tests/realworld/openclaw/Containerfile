# Proof 8 (openclaw): the real OpenClaw gateway 2026.10.7, Lunchroom's real plugin loaded in it, and the
# paths a tool call takes through the plugin.
#
# OpenClaw is the npm package `openclaw`, pinned to 2026.10.7, the release the host facts
# (docs/host-facts/openclaw-and-hermes.md) were read at; it requires Node >=24.22.1 <25 (its own
# preinstall check), so the base is node:24. The build stops if the installed release is not 2026.10.7.
#
# Build context: made by ../prove.sh.
FROM docker.io/library/node:24

ENV DEBIAN_FRONTEND=noninteractive
ENV DISTRO=npm
RUN apt-get update \
 && apt-get install -y --no-install-recommends sudo python3 procps util-linux ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g openclaw@2026.10.7 \
 && openclaw --version | tee /tmp/openclaw.version \
 && grep -q '^OpenClaw 2026.10.7 ' /tmp/openclaw.version

COPY lunchroom lib.sh ptyrun.py plaintext.py chatmock.py inner.sh /opt/proof/
RUN chmod 0755 /opt/proof/lunchroom /opt/proof/inner.sh /opt/proof/ptyrun.py /opt/proof/plaintext.py \
      /opt/proof/chatmock.py

CMD ["/opt/proof/inner.sh"]
